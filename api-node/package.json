{
  "name": "portfolio-api-node",
  "version": "1.0.0",
  "private": true,
  "description": "API do portfólio de Rafael Freire — DWII",
  "main": "server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "criar-usuario": "node --env-file-if-exists=.env criar-usuario.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  }
}
